# NetBird — overlay-сеть на WireGuard, для работы.
#
# Версия берётся из unstable: в nixos-26.05 лежит 0.71.4, в unstable — 0.82.0.
# Разрыв в 11 минорных версий, а клиент должен быть совместим с
# management-сервером, поэтому берём свежий.
#
# ВАЖНО: вместе с пакетом берётся и МОДУЛЬ из unstable. Одного пакета мало —
# модуль из 26.05 собирает wrapper вокруг netbird-ui и патчит его .desktop
# через --replace-fail, ожидая строки версии 0.71:
#
#   модуль 26.05 ждёт        в 0.82 реально
#   Name=Netbird             Name=NetBird
#   Exec=netbird-ui          Exec=env WEBKIT_DISABLE_DMABUF_RENDERER=1 netbird-ui
#
# Обе подстановки падают, и сборка системы валится целиком. Модуль из unstable
# ожидает ровно то, что есть в 0.82, поэтому согласованная пара модуль+пакет
# надёжнее, чем патчить .desktop у себя: при следующем обновлении unstable
# строки снова поедут, а так они всегда совпадают.
#
# Wrapper, к слову, не косметика: netbird-ui не читает переменные окружения,
# и адрес сокета демона ему передаётся флагом --daemon-addr. Поэтому
# netbird-ui, поставленный просто пакетом, демон бы не нашёл.
{
  inputs,
  pkgs,
  ...
}:

{
  disabledModules = [ "services/networking/netbird.nix" ];
  imports = [ "${inputs.nixpkgs-unstable}/nixos/modules/services/networking/netbird.nix" ];

  services.netbird = {
    enable = true;

    package = pkgs.unstable.netbird;
    # ui.enable включается само при наличии графической сессии
    # (services.xserver.enable = true в desktop.nix), поэтому задаём только
    # пакет, чтобы версии демона и трея не разъехались.
    ui.package = pkgs.unstable.netbird-ui;

    # Нужно, чтобы работали Network Routes, Network Resources и Exit Nodes.
    #
    # "client" переводит reverse path filtering в loose. Это не косметика: при
    # строгом rp_filter ядро отбрасывает ответные пакеты из маршрутизируемых
    # через NetBird подсетей, потому что приходят они не с того интерфейса, с
    # которого ушёл запрос. Симптом — маршрут есть, пинг не идёт.
    #
    # Не "server" и не "both": это включило бы ip_forward, а он нужен только
    # если машина сама раздаёт маршруты другим пирам. Ноутбук — потребитель.
    useRoutingFeatures = "client";
  };

  # ВНИМАНИЕ: КОНФЛИКТ МАРШРУТОВ С ЛОКАЛЬНОЙ СЕТЬЮ
  #
  # Локальная сеть за OpenWrt — 192.168.1.0/24, шлюз 192.168.1.1, эта машина
  # 192.168.1.100. Это самая распространённая подсеть по умолчанию в мире, и
  # ровно поэтому она опасна.
  #
  # Сам по себе NetBird не конфликтует: пиринговая сеть живёт в 100.64.0.0/10
  # (CGNAT-диапазон), пересечений с 192.168.1.0/24 и docker0 (172.17.0.0/16)
  # там нет. Опасность в другом — в Network Routes, которые раздаёт
  # администратор с management-сервера. Если в рабочей сети есть маршрут на
  # 192.168.1.0/24 (а он есть почти всегда — офисы сидят на той же подсети),
  # то при подключении NetBird перехватит весь локальный трафик:
  #   - 192.168.1.1 (ваш OpenWrt) станет недоступен,
  #   - вместе с ним пропадёт интернет, потому что это шлюз по умолчанию.
  #
  # Это НЕ лечится конфигурацией на стороне Nix: маршруты приходят с сервера,
  # клиент их только принимает. Варианты, по убыванию надёжности:
  #
  #   1. Перенумеровать домашнюю сеть на OpenWrt во что-то редкое —
  #      10.37.84.0/24 или 192.168.73.0/24. Надёжно и навсегда, потому что
  #      убирает саму возможность пересечения.
  #   2. Попросить администратора не включать вашего пира в группу
  #      распространения маршрута 192.168.1.0/24.
  #   3. Отключить конкретный маршрут на этой машине:
  #           netbird networks list
  #           netbird networks deselect <id>
  #      Работает, но живёт в состоянии клиента, а не в Nix — после
  #      переустановки или сброса состояния придётся повторять.
  #
  #      ВНИМАНИЕ про имя подкоманды: в 0.82 это `networks`, а не `routes`.
  #      Переименование произошло между 0.71 (версия в nixos-26.05) и 0.82,
  #      так что гайды в интернете и вывод `--help` старых сборок будут
  #      показывать `netbird routes` — на нашей версии это не сработает.
  #
  # Проверять конфликт нужно ПОСЛЕ подключения, а не до: `netbird networks list`
  # покажет, раздаётся ли вообще маршрут на 192.168.1.0/24. Если нет —
  # перенумеровывать домашнюю сеть незачем.
  #
  # Отдельно: в системе уже включён programs.amnezia-vpn. Два VPN
  # одновременно будут спорить за маршрут по умолчанию — держите включённым
  # что-то одно.
}
