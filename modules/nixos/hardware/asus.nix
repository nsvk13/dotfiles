# ASUS ROG / TUF platform integration.
# Canon: https://asus-linux.org/ and the newer https://opengamingcollective.github.io/
# asusctl/ — the asusd daemon (asusctl) and the ROG Control Center GUI. Imported only by
# the ASUS laptop host (tuf).
{ config, pkgs, ... }:

{
  # NOTE: we deliberately do NOT set boot.kernelPackages = pkgs.linuxPackages_latest here,
  # even though asus-linux.org recommends a recent kernel for the asus-wmi / amdgpu fixes.
  # linuxPackages_latest (7.3.1) outpaces nvidia-open 595.71.05: the out-of-tree module
  # fails to compile (implicit declaration of `strncpy`). The 26.05 default (6.18.60) gives
  # us asus-wmi / asus-nb-wmi — enough for asusd, backlight, fan curves and the hotkeys —
  # and builds nvidia fine. What it does NOT have is `asus-armoury`, still not upstreamed,
  # so ROG Control Center logs an error and its GPU / System pages stay inert. That is the
  # price of a kernel the nvidia module can build against. Revisit only after confirming
  # the nvidia release in nixpkgs supports the kernel you are moving to.

  # asusctl + asusd: keyboard backlight / aura, custom fan curves, platform & power
  # profiles, battery charge limit, panel overdrive. Installs the `asusctl` CLI and the
  # `rog-control-center` GUI and wires up dbus / udev.
  #
  # NB: `services.asusd.enableUserService` was REMOVED in nixpkgs 26.05 (the asusd user
  # service is no longer required), so we don't set it — the asus-linux.org NixOS guide
  # still shows it and is out of date. Likewise the supergfxd `pciutils` PATH workaround
  # from that guide is already baked into the 26.05 module.
  services.asusd.enable = true;

  # asusd.service (shipped by asusctl, not generated by nixpkgs) runs with
  # ProtectSystem=strict and ReadWritePaths=/etc/asusd. systemd must bind-mount that
  # path to build the namespace, so a missing directory is fatal:
  #
  #   asusd.service: Failed to set up mount namespacing:
  #   /etc/asusd: No such file or directory
  #   asusd.service: Failed at step NAMESPACE spawning .../asusd: No such file or directory
  #   (status=226/NAMESPACE)
  #
  # The nixpkgs module only populates `environment.etc."asusd/*.ron"` for the config
  # options you actually set (animeConfig, asusdConfig, fanCurvesConfig, ...). All of them
  # default to null, so with a stock `services.asusd.enable = true` nothing creates
  # /etc/asusd and the daemon never starts — a nixpkgs bug, worked around here.
  #
  # tmpfiles (not environment.etc) on purpose: asusd WRITES this directory itself — it
  # persists asusd.ron, aura_tuf.ron and fan_curves.ron as you change profiles, fan curves
  # and keyboard lighting with asusctl / ROG Control Center. It therefore has to be a real
  # writable directory, not a read-only tree of nix-store symlinks. "d" also leaves
  # existing contents alone, so tuned fan curves survive a rebuild.
  #
  # Ordering is already guaranteed: asusd.service takes the default dependencies, so it is
  # After=systemd-tmpfiles-setup.service, and `nixos-rebuild switch` runs
  # systemd-tmpfiles --create during activation too.
  systemd.tmpfiles.rules = [ "d /etc/asusd 0755 root root -" ];

  # asusctl 6.x (26.05 ships 6.3.7) drives the kernel platform_profile and CPU EPP
  # itself — asusd IS the profile daemon. So do NOT run power-profiles-daemon or TLP
  # alongside: upstream warns they fight asusd over platform_profile / EPP. Switch
  # profiles with `asusctl profile <...>` or ROG Control Center (autostarted below).
  #
  # If you want KDE's tray power slider (which needs PPD) back, the alternative is to
  # keep power-profiles-daemon enabled AND tell asusd to stand down, by writing
  # change_platform_profile_on_ac / change_platform_profile_on_battery /
  # platform_profile_linked_epp = false into services.asusd.asusdConfig (/etc/asusd/
  # asusd.ron). We take the simpler path and let asusd own profiles.

  # ROG Control Center, autostarted in the graphical session: the ASUS tray plus the
  # desktop notifications on profile / charge changes. Bound to graphical-session so it
  # comes up under both Plasma and driftwm. Set "close to tray" in its settings once and
  # it stops popping the window on login.
  systemd.user.services.rog-control-center = {
    description = "ROG Control Center (ASUS tray + notifications)";
    wantedBy = [ "graphical-session.target" ];
    partOf = [ "graphical-session.target" ];
    after = [ "graphical-session.target" ];
    serviceConfig = {
      ExecStart = "${config.services.asusd.package}/bin/rog-control-center";
      Restart = "on-failure";
      RestartSec = 3;
    };
  };
}
