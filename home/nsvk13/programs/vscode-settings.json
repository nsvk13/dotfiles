{
  "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "editor.fontSize": 13,
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "trailing",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "update.mode": "none",
  "extensions.autoUpdate": "off",
  "telemetry.telemetryLevel": "off",

  // Copilot приезжает ВСТРОЕННЫМ в сам VS Code (resources/app/extensions/copilot),
  // поэтому его нет в списке расширений в vscode.nix и удалить его оттуда нельзя.
  // disableAIFeatures — родной рубильник редактора: он же выставляется, когда
  // встроенное chat-расширение выключают руками, и гейтит все AI-команды.
  // inlineSuggest — страховка от серого призрачного текста в редакторе, кто бы
  // его ни поставлял. Обычный IntelliSense это не задевает.
  "chat.disableAIFeatures": true,
  "editor.inlineSuggest.enabled": false,
  "github.copilot.enable": { "*": false },
  "github.copilot.nextEditSuggestions.enabled": false,

  // Раскладка переключается Alt+Shift (modules/nixos/base.nix:81,
  // grp:alt_shift_toggle), а VS Code под Wayland рисует меню сам и по Alt
  // уводит в него фокус. Отсюда и прыжки в File/Edit при смене языка:
  // редактор видит Alt и считает, что зовут меню. Гасим обе Alt-реакции —
  // меню остаётся на месте и открывается мышью, F10 и Ctrl+Shift+P.
  "window.customMenuBarAltFocus": false,
  "window.enableMenuBarMnemonics": false,

  "nix.enableLanguageServer": true,
  "nix.serverPath": "nil",
  "nix.formatterPath": "nixfmt",
  "nix.serverSettings": {
    "nil": {
      "formatting": {
        "command": ["nixfmt"]
      }
    }
  },

  "ansible.python.interpreterPath": "python3",
  "git.autofetch": true,
  "git.confirmSync": false,
  "workbench.colorTheme": "Visual Studio Dark",
  "workbench.iconTheme": "material-icon-theme"
}
